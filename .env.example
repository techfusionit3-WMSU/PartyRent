APP_NAME=PartyRent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=partyrent
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sign-up codes, password resets and notices are sent from the team Gmail.
# MAIL_PASSWORD is the 16-character Gmail App Password (ask the team; never commit it). Paste it with no spaces,
# then run: php artisan config:clear   and test with: php artisan partyrent:mail-test you@gmail.com
# Without a password (or with MAIL_MAILER=log) nothing is emailed: on a local copy the sign-up page shows the code instead.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=fahadudz@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="fahadudz@gmail.com"
MAIL_FROM_NAME="PartyRent"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Xendit online payments ("Pay online"). Sign up at dashboard.xendit.co; test keys (xnd_development_…)
# work right away. Set the key to switch from PayMongo/practice mode to Xendit.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_METHODS=

# PayMongo online payments. Test keys (sk_test_…) from dashboard.paymongo.com → Developers.
# Empty secret key = "Pay online" is hidden and customers pay by transfer only.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_METHODS=gcash,paymaya,card,qrph
# No PayMongo account yet? PAYMONGO_FAKE=true shows a practice checkout (local only, no real money).
PAYMONGO_FAKE=false
